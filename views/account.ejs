<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <meta charset="UTF-8">
    <title>Friendly AI</title>
    <!-- PASTE YOUR ORIGINAL <link rel="icon" ...> LINE HERE -->
    <link rel="stylesheet" href="account_style.css">
    <style>
      .chat-frame { width: 100%; max-width: 1100px; height: 680px; border: none; display: block; margin: 20px auto; border-radius: 12px; }

      .logo.brand { display: flex; align-items: center; gap: 10px; margin: 0; }
      .brand-spark { width: 14px; height: 14px; border-radius: 50%; background: radial-gradient(circle, #fff 0%, #ffd166 40%, transparent 70%); box-shadow: 0 0 12px #ffd166; animation: pulse 2s ease-in-out infinite; }
      .brand-text { font-family: 'Trebuchet MS', Arial, sans-serif; font-size: 28px; font-weight: 800; letter-spacing: 1px; background: linear-gradient(90deg, #ffd166, #ff7eb6, #7ec8ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .brand-text em { font-style: normal; font-weight: 300; letter-spacing: 3px; }
      @keyframes pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.4); opacity: 0.6; } }

      html, body { min-height: 100%; overflow-x: hidden; }

      body {
        background: linear-gradient(-45deg, #1b1f4b, #3b1f5c, #0f3d4c, #1e2a6b);
        background-size: 600% 600%;
        animation: bgShift 24s ease infinite;
        position: relative;
      }

      body::before, body::after {
        content: '';
        position: fixed;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.35;
        z-index: -1;
        pointer-events: none;
      }
      body::before {
        width: 480px; height: 480px;
        background: #ff7eb6;
        top: 10%; left: 5%;
        animation: floatA 12s ease-in-out infinite;
      }
      body::after {
        width: 260px; height: 260px;
        background: #7ec8ff;
        bottom: 8%; right: 6%;
        animation: floatB 14s ease-in-out infinite;
      }

      @keyframes bgShift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      @keyframes floatA {
        0%, 100% { transform: translate(0, 0); }
        50%      { transform: translate(60px, 40px); }
      }
      @keyframes floatB {
        0%, 100% { transform: translate(0, 0); }
        50%      { transform: translate(-50px, -30px); }
      }

      /* ---------- About card ---------- */
      #about-section {
        max-width: 820px;
        margin: 40px auto;
        padding: 36px 40px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(10px);
        text-align: center;
        color: #f1efff;
        line-height: 1.7;
      }
      #about-section h2 {
        margin: 0 0 18px;
        font-size: 30px;
        font-weight: 800;
        background: linear-gradient(90deg, #ffd166, #ff7eb6, #7ec8ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      #about-section p {
        margin: 0 0 14px;
        font-size: 17px;
        color: #e6e3ff;
      }
      #about-section p:last-child {
        margin-bottom: 0;
        font-style: italic;
        color: #ffd9ec;
      }

      /* ---------- FAQ card ---------- */
      #faqs-section {
        max-width: 820px;
        margin: 40px auto;
        padding: 36px 40px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(10px);
        color: #f1efff;
        line-height: 1.6;
      }
      #faqs-section h2 {
        margin: 0 0 22px;
        font-size: 28px;
        font-weight: 800;
        text-align: center;
        background: linear-gradient(90deg, #ffd166, #ff7eb6, #7ec8ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      #faqs-section ul { list-style: none; padding: 0; margin: 0; }
      #faqs-section li {
        padding: 16px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }
      #faqs-section li:last-child { border-bottom: none; }
      #faqs-section li strong {
        display: block;
        font-size: 18px;
        color: #ffd166;
        margin-bottom: 6px;
      }
      #faqs-section li p {
        margin: 0;
        font-size: 16px;
        color: #e6e3ff;
      }

      /* ---------- Footer: hidden until Contact Us is clicked ---------- */
      .site-footer {
        display: none;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 8px 5vw;
        background: linear-gradient(90deg, rgba(20, 24, 60, 0.95), rgba(45, 25, 80, 0.95));
        border-top: 2px solid #ffd166;
        text-align: center;
        color: #e8e6ff;
      }
      .site-footer.show { display: block; }
      .site-footer h2 {
        margin: 0 0 6px;
        font-size: 16px;
        color: #ffd166;
        letter-spacing: 1px;
      }
      .contact-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        width: 100%;
      }
      .contact-row span,
      .contact-row a {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px 8px;
        border-radius: 8px;
        background: rgba(126, 200, 255, 0.12);
        border: 1px solid rgba(126, 200, 255, 0.25);
        color: #e8e6ff;
        text-decoration: underline;
        font-size: 13px;
      }
      .contact-row a:hover {
        background: rgba(255, 126, 182, 0.25);
        border-color: #ff7eb6;
        color: #fff;
      }

      @media (max-width: 700px) {
        .contact-row { grid-template-columns: 1fr; }
        #about-section, #faqs-section { margin: 24px 16px; padding: 24px 20px; }
        #about-section h2 { font-size: 24px; }
        #faqs-section h2 { font-size: 22px; }
      }
    </style>
</head>
<body>
    <header class="header">
        <nav class="navbar">
          <h2 class="logo brand"><span class="brand-spark"></span><span class="brand-text">Friendly <em>AI</em></span></h2>
          <div class="buttons">
            <div class="dropdown">
            <h3 class="hi"><b>Welcome,<a href="#"><b><i><%= user.username %></i></b></a></b></h3>
            <div class="dropdown-content">
              <a href="Home_Page.html">Home</a>
              <a href="#" id="account-info-link">Account info</a>
              <a href="/settings">Settings</a>
              <a href="#" id="about-us-link">About Us</a>
              <a href="#" id="contact-us-link">Contact Us</a>
              <a href="/logout">Logout</a>
            </div>
            <% if (message) { %>
              <div id="message" class="message"><%= message %></div>
            <% } %>
        </div>
        </nav>
    </header>

    <div class="account-details" id="accountDetails" style="display: none;">
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Phone:</strong> <%= user.phone %></p>
        <p><strong>Address:</strong> <%= user.address %></p>
    </div>

    <!-- Chat with Gemini: the full chat page is loaded here -->
    <iframe class="chat-frame" src="/chat.html" title="Chat with Friendly AI"></iframe>

    <div class="about-content" id="about-section" style="display: none;">
      <h2>🌈 About Friendly AI</h2>
      <p>
        Friendly AI is a warm, easy-to-use chat assistant. You can ask it anything, from everyday
        questions and planning your day to writing, learning, and checking the latest news or weather.
        It replies in plain, friendly language, and it remembers your conversations so you can pick up
        where you left off.
      </p>
      <p>
        We built Friendly AI to make artificial intelligence feel approachable. You don't need technical
        skills to start. Just type your question, and you're chatting.
      </p>
    </div>

    <div class="faqs-content" id="faqs-section" style="display: none;">
      <h2>Frequently Asked Questions (FAQs)</h2>
      <ul>
        <li><strong>What is Friendly AI?</strong>
          <p>Friendly AI is a chat assistant that answers questions, helps you plan, and explains things in plain language.</p>
        </li>
        <li><strong>How can I create an account?</strong>
          <p>Click "Join Now" or "Sign in", fill in the required details, and follow the instructions to complete your registration.</p>
        </li>
        <li><strong>What services do you offer?</strong>
          <p>Chat conversations with live search for weather, news, and prices, plus projects to organise your chats.</p>
        </li>
        <li><strong>Is my data secure?</strong>
          <p>We keep your details private and only use them to run your account. Please keep your password safe.</p>
        </li>
        <li><strong>Can I request a custom AI solution?</strong>
          <p>Of course! Contact us using the details in the Contact Us section.</p>
        </li>
      </ul>
    </div>

    <footer id="contact-section" class="site-footer">
      <h2>Contact Us</h2>
      <div class="contact-row">
        <span>📧 abcxyz@outlook.com</span>
        <span>📞 +61412345678</span>
        <a href="#" id="faqs-link">❓ Do you have any questions? Click here</a>
      </div>
    </footer>

    <script>
      window.onload = function () {
        // Display message and hide after a few seconds
        var message = document.getElementById('message');
        if (message) {
          message.style.display = 'block';
          setTimeout(function () {
            message.style.opacity = '0';
            setTimeout(function () {
              message.style.display = 'none';
              fetch('/clear-message', { method: 'POST' });
            }, 1000);
          }, 3000);
        }
      };

      document.getElementById('about-us-link').addEventListener('click', function (event) {
        event.preventDefault();
        var aboutContent = document.getElementById('about-section');
        document.getElementById('contact-section').classList.remove('show');
        document.getElementById('faqs-section').style.display = 'none';
        if (aboutContent.style.display === 'none' || aboutContent.style.display === '') {
          aboutContent.style.display = 'block';
          aboutContent.scrollIntoView({ behavior: 'smooth' });
        } else {
          aboutContent.style.display = 'none';
        }
      });

      document.getElementById('contact-us-link').addEventListener('click', function (event) {
        event.preventDefault();
        var footer = document.getElementById('contact-section');
        document.getElementById('about-section').style.display = 'none';
        document.getElementById('faqs-section').style.display = 'none';
        footer.classList.toggle('show');
        if (footer.classList.contains('show')) {
          footer.scrollIntoView({ behavior: 'smooth' });
        }
      });

      document.getElementById('faqs-link').addEventListener('click', function (event) {
        event.preventDefault();
        var faqsContent = document.getElementById('faqs-section');
        document.getElementById('about-section').style.display = 'none';
        if (faqsContent.style.display === 'none' || faqsContent.style.display === '') {
          faqsContent.style.display = 'block';
          faqsContent.scrollIntoView({ behavior: 'smooth' });
        } else {
          faqsContent.style.display = 'none';
        }
      });

      document.getElementById('account-info-link').addEventListener('click', function (event) {
        event.preventDefault();
        var details = document.getElementById('accountDetails');
        details.style.display = details.style.display === 'none' ? 'block' : 'none';
      });
    </script>
</body>
</html>