<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>SETTINGS</title>
      <link rel="icon" href="data:image/jpeg;base64,
    " type="image/png">
  <link rel="stylesheet" href="settings_style.css">
</head>
<body>
  <header class="header">
    <nav class="navbar">
        <div class="buttons">
            <div class="dropdown"> 
            <h3 class ="hi"><b>Welcome,<a href="#"><b><i><%= user.username %></i></b></a></b></h3>
            <div class="dropdown-content">
              <a href="Home_Page.html">Home</a>
              <a href="/account">Your Account</a>
              <a href="/settings">Settings</a>
              <a href="/logout">Logout</a>
            </div>
        </div>
      </div>
    </nav>
  </header>
  
  <div class="container">
    <form id="settingsForm" action="http://localhost:8080/update-settings" method="POST">
      <b><h3>UPDATE YOUR INFORMATION</h3></b>
      <label for="username">USERNAME</label>
      <input type="text" id="username" name="username" value="<%= user.username %>" readonly>
      <span id="usernameError" class="error"></span>

      <label for="email">EMAIL</label>
      <input type="email" id="email" name="email" value="<%= user.email %>"
      pattern="^[a-zA-Z0-9._%+-]+@gmail\.com$" title="Please enter a valid email address." required>
      <span id="emailError" class="error"></span>

      <label for="phone">PHONE NO.</label>
      <input type="tel" id="phone" name="phone" value="<%= user.phone %>" required
      pattern="^\+61[1-9][0-9]{8}$" maxlength="12"
      title="Please enter a valid Australian phone number. Example: +61412345678">
      <span id="phoneError" class="error"></span>

      <label for="streetaddress">Street Address:</label>
      <input type="text" id="streetaddress" name="streetaddress" value="<%= user.address.split(', ')[0] %>"
      title="Please enter a valid street address (e.g., 'unit 2/1 ABC Road' or '2/1 ABC Road or 2 abc rd')"
      pattern="^(unit \d+\/\d+ \w+ \w+|\d+\/\d+ \w+ \w+|\d+ \w+ \w+)$" required>
      <span id="addressError" class="error"></span>

      <label for="suburb">Suburb:</label>
      <input type="text" id="suburb" name="suburb" value="<%= user.address.split(', ')[1] %>" required>
      <span id="suburbError" class="error"></span>

      <label for="state">State/Territory:</label>
      <select id="state" name="state" required>
        <option value="ACT" <%= user.address.split(', ')[2] === 'ACT' ? 'selected' : '' %>>Australian Capital Territory</option>
        <option value="NSW" <%= user.address.split(', ')[2] === 'NSW' ? 'selected' : '' %>>New South Wales</option>
        <option value="NT" <%= user.address.split(', ')[2] === 'NT' ? 'selected' : '' %>>Northern Territory</option>
        <option value="QLD" <%= user.address.split(', ')[2] === 'QLD' ? 'selected' : '' %>>Queensland</option>
        <option value="SA" <%= user.address.split(', ')[2] === 'SA' ? 'selected' : '' %>>South Australia</option>
        <option value="TAS" <%= user.address.split(', ')[2] === 'TAS' ? 'selected' : '' %>>Tasmania</option>
        <option value="VIC" <%= user.address.split(', ')[2] === 'VIC' ? 'selected' : '' %>>Victoria</option>
        <option value="WA" <%= user.address.split(', ')[2] === 'WA' ? 'selected' : '' %>>Western Australia</option>
      </select>
      <span id="stateError" class="error"></span>

      <label for="postcode">Postcode:</label>
      <input type="text" id="postcode" name="postcode"
      maxlength="4" value="<%= user.address.split(', ')[3] %>"
      pattern="^(?!0000)\d{4}$" title="Please enter a valid 4-digit postcode (not 0000)." required>
      <span id="postcodeError" class="error"></span>

      <label for="country">Country:</label>
      <input type="text" id="country" name="country" value="<%= user.address.split(', ')[4] %>" readonly>

      <label for="password">NEW PASSWORD</label>
      <input type="password" id="password" name="password" minlength="10" maxlength="18" 
      title="Must contain at least one number and one uppercase and lowercase letter,
              within 10 to 18 characters and should not end with any special characters(@,$,^,&,...)" 
      placeholder="Enter your new password">
      <span id="passwordError" class="error"></span>

      <label for="confirm-password">CONFIRM NEW PASSWORD</label>
      <input type="password" id="confirm-password" name="confirm-password" placeholder="Confirm your new password">
      <span id="confirmPasswordError" class="error"></span>

      <button type="submit" id="submitBtn" disabled>Update</button>
    </form>
  </div>
  <div id="message">
    <h3>Password must contain the following:</h3>
    <p id="letter" class="invalid">A <b>lowercase</b> letter</p>
    <p id="capital" class="invalid">A <b>capital (uppercase)</b> letter</p>
    <p id="number" class="invalid">A <b>number</b></p>
    <p id="length" class="invalid"><b>within range of 10 to 18 characters</b></p>
    <p id="lastChar" class="invalid"><b>Should not end with special characters[@,#,&,,,,,]</b></p>
  </div>
  
  <script src="DataValid.js"></script>
  <script>

    // Client-side email pattern validation and confirmation dialog
   document.getElementById('settingsForm').addEventListener('submit', function(event) {
            const email = document.getElementById('email').value;

            // Validate the email using the regex pattern
            const emailPattern = /^[a-zA-Z0-9._%+-]+@gmail\.com$/;
            
            if (!emailPattern.test(email)) {
              const approval = confirm(`Do you want to accept the email: ${email}?`);
               // If user approves, display success message
        if (approval) {
          alert('Thank you! Your email has been accepted.');
        } else {
            event.preventDefault();
            alert('You must confirm your email before submitting.')
        }
      }
      });
    // Real-time validation and feedback
    const form = document.getElementById('settingsForm');
    const submitBtn = document.getElementById('submitBtn');
    
    form.addEventListener('input', function(event) {
      const isValid = form.checkValidity();
      submitBtn.disabled = !isValid;
    });

    // Password confirmation validation
    form.addEventListener('submit', function(event) {
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirm-password').value;
      if (password !== confirmPassword) {
        event.preventDefault();
        document.getElementById('confirmPasswordError').textContent = 'Passwords do not match.';
      }
    });
  </script>
</body>
</html>
