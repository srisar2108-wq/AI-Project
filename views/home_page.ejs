<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Friendly AI</title>
    <!-- PASTE YOUR ORIGINAL <link rel="icon" ...> LINE HERE -->
    <link rel="stylesheet" href="home_style.css">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <style>
      .contact-row a,
      .contact-row a:visited {
        color: #fff !important;
        text-decoration: underline;
      }

      .animated-desc span {
        display: inline-block;
        opacity: 0;
        transform: translateY(14px);
        animation: wordIn 0.6s ease forwards;
        animation-delay: calc(var(--i) * 0.08s);
      }
      @keyframes wordIn {
        to { opacity: 1; transform: translateY(0); }
      }

      .logo.brand { display: flex; align-items: center; gap: 10px; margin: 0; }
      .brand-spark { width: 14px; height: 14px; border-radius: 50%; background: radial-gradient(circle, #fff 0%, #ffd166 40%, transparent 70%); box-shadow: 0 0 12px #ffd166; animation: pulse 2s ease-in-out infinite; }
      .brand-text { font-family: 'Trebuchet MS', Arial, sans-serif; font-size: 28px; font-weight: 800; letter-spacing: 1px; background: linear-gradient(90deg, #ffd166, #ff7eb6, #7ec8ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .brand-text em { font-style: normal; font-weight: 300; letter-spacing: 3px; }
      @keyframes pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.4); opacity: 0.6; } }

      html, body { min-height: 100%; overflow-x: hidden; }

      body {
        background: linear-gradient(-45deg, #1b1f4b, #3b1f5c, #0f3d4c, #1e2a6b);
        background-size: 600% 600%;
        animation: bgShift 24s ease infinite;
        position: relative;
      }

      body::before, body::after {
        content: '';
        position: fixed;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.35;
        z-index: -1;
        pointer-events: none;
      }
      body::before {
        width: 480px; height: 480px;
        background: #ff7eb6;
        top: 10%; left: 5%;
        animation: floatA 12s ease-in-out infinite;
      }
      body::after {
        width: 260px; height: 260px;
        background: #7ec8ff;
        bottom: 8%; right: 6%;
        animation: floatB 14s ease-in-out infinite;
      }

      @keyframes bgShift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      @keyframes floatA {
        0%, 100% { transform: translate(0, 0); }
        50%      { transform: translate(60px, 40px); }
      }
      @keyframes floatB {
        0%, 100% { transform: translate(0, 0); }
        50%      { transform: translate(-50px, -30px); }
      }

      /* ---------- Footer: hidden until Contact Us is clicked ---------- */
      .site-footer {
  display: none;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  padding: 8px 5vw;
  background: linear-gradient(90deg, rgba(20, 24, 60, 0.95), rgba(45, 25, 80, 0.95));
  border-top: 2px solid #ffd166;
  text-align: center;
  color: #e8e6ff;
}
.site-footer.show { display: block; }

.site-footer h2 {
  margin: 0 0 6px;
  font-size: 16px;
  color: #ffd166;
  letter-spacing: 1px;
}

.contact-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  width: 100%;
}

.contact-row span,
.contact-row a {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px 8px;
  border-radius: 8px;
  background: rgba(126, 200, 255, 0.12);
  border: 1px solid rgba(126, 200, 255, 0.25);
  color: #e8e6ff;
  text-decoration: none;
  font-size: 13px;
}
.contact-row a:hover {
  background: rgba(255, 126, 182, 0.25);
  border-color: #ff7eb6;
  color: #fff;
}

.contact-row a,
.contact-row a:visited {
  color: #e8e6ff !important;
  text-decoration: underline;
}

      @media (max-width: 700px) {
        .contact-row { grid-template-columns: 1fr; }
      }

  /* ---------- About card ---------- */
#about-section {
  max-width: 820px;
  margin: 40px auto;
  padding: 36px 40px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(10px);
  text-align: center;
  color: #f1efff;
  line-height: 1.7;
}

#about-section h2 {
  margin: 0 0 18px;
  font-size: 30px;
  font-weight: 800;
  background: linear-gradient(90deg, #ffd166, #ff7eb6, #7ec8ff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

#about-section p {
  margin: 0 0 14px;
  font-size: 17px;
  color: #e6e3ff;
}

#about-section p:last-child {
  margin-bottom: 0;
  font-style: italic;
  color: #ffd9ec;
}

@media (max-width: 700px) {
  #about-section { margin: 24px 16px; padding: 24px 20px; }
  #about-section h2 { font-size: 24px; }
}
/* ---------- FAQ card ---------- */
#faqs-section {
  max-width: 820px;
  margin: 40px auto;
  padding: 36px 40px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(10px);
  color: #f1efff;
  line-height: 1.6;
}

#faqs-section h2 {
  margin: 0 0 22px;
  font-size: 28px;
  font-weight: 800;
  text-align: center;
  background: linear-gradient(90deg, #ffd166, #ff7eb6, #7ec8ff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

#faqs-section ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

#faqs-section li {
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
#faqs-section li:last-child { border-bottom: none; }

#faqs-section li strong {
  display: block;
  font-size: 18px;
  color: #ffd166;
  margin-bottom: 6px;
}

#faqs-section li p {
  margin: 0;
  font-size: 16px;
  color: #e6e3ff;
}

@media (max-width: 700px) {
  #faqs-section { margin: 24px 16px; padding: 24px 20px; }
  #faqs-section h2 { font-size: 22px; }
}
/* ---------- Animated character (left side) ---------- */
.side-character {
  position: fixed;
  left: 2vw;
  bottom: 6vh;
  width: 200px;
  z-index: 1;
  pointer-events: none;
}
.side-character svg {
  width: 100%;
  height: auto;
  overflow: visible;
}

/* Whole figure bobs up and down */
.side-character .figure {
  transform-box: view-box;
  animation: bob 2.6s ease-in-out infinite;
}
@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}

/* Right arm waves from the shoulder */
.side-character .wave-arm {
  transform-box: view-box;
  transform-origin: 145px 126px;
  animation: wave 1.6s ease-in-out infinite;
}
@keyframes wave {
  0%, 100% { transform: rotate(0deg); }
  25%      { transform: rotate(-22deg); }
  50%      { transform: rotate(4deg); }
  75%      { transform: rotate(-22deg); }
}

/* Eyes blink now and then */
.side-character .eye {
  transform-box: fill-box;
  transform-origin: center;
  animation: blink 4s infinite;
}
@keyframes blink {
  0%, 92%, 100% { transform: scaleY(1); }
  95%           { transform: scaleY(0.1); }
}

/* Typing dots in the speech bubble */
.side-character .dot {
  transform-box: fill-box;
  animation: typing 1.2s infinite;
}
.side-character .d2 { animation-delay: 0.2s; }
.side-character .d3 { animation-delay: 0.4s; }
@keyframes typing {
  0%, 60%, 100% { opacity: 0.25; transform: translateY(0); }
  30%           { opacity: 1;    transform: translateY(-4px); }
}

/* Hide the character on narrow screens so it doesn't cover the text */
@media (max-width: 1100px) {
  .side-character { display: none; }
}
.side-character .ponytail {
  transform-box: fill-box;
  transform-origin: 0% 0%;
  animation: swing 2.6s ease-in-out infinite;
}
@keyframes swing {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(6deg); }
}
/* ---------- Animated bird (bottom right) ---------- */
.side-bird {
  position: fixed;
  top: 14vh;
  right: 8vw;
  width: 150px;
  z-index: 1;
  pointer-events: none;
  animation: birdFly 9s ease-in-out infinite;
}
.side-bird svg {
  width: 100%;
  height: auto;
  overflow: visible;
}

/* The bird drifts in a gentle loop */
@keyframes birdFly {
  0%   { transform: translate(0, 0) rotate(0deg); }
  25%  { transform: translate(-30px, -18px) rotate(-4deg); }
  50%  { transform: translate(-60px, 0) rotate(0deg); }
  75%  { transform: translate(-30px, 18px) rotate(4deg); }
  100% { transform: translate(0, 0) rotate(0deg); }
}

/* Wings flap */
.side-bird .wing {
  transform-box: fill-box;
  transform-origin: 70% 90%;
  animation: flap 0.45s ease-in-out infinite alternate;
}
.side-bird .wing-front {
  animation-delay: 0.05s;
}
@keyframes flap {
  from { transform: scaleY(1) rotate(0deg); }
  to   { transform: scaleY(0.55) rotate(-10deg); }
}

/* Eye blinks now and then */
.side-bird .bird-eye {
  transform-box: fill-box;
  transform-origin: center;
  animation: birdBlink 5s infinite;
}
@keyframes birdBlink {
  0%, 94%, 100% { transform: scaleY(1); }
  97%           { transform: scaleY(0.1); }
}

/* Hide on narrow screens */
@media (max-width: 1100px) {
  .side-bird { display: none; }
}
/* ---------- Animated tree (bottom right) ---------- */
.side-tree {
  position: fixed;
  right: 6vw;
  bottom: 4vh;
  width: 150px;
}
.side-tree svg {
  width: 100%;
  height: auto;
  overflow: visible;
}

/* Crown sways gently from the trunk */
.side-tree .tree-crown {
  transform-box: fill-box;
  transform-origin: 50% 100%;
  animation: treeSway 4s ease-in-out infinite;
}
@keyframes treeSway {
  0%, 100% { transform: rotate(-1.5deg); }
  50%      { transform: rotate(1.5deg); }
}

/* Leaves drift down and fade, then restart */
.side-tree .leaf {
  animation: leafFall 6s linear infinite;
  opacity: 0;
}
.side-tree .l2 { animation-delay: 2s; }
.side-tree .l3 { animation-delay: 4s; }
@keyframes leafFall {
  0%   { transform: translate(0, 0) rotate(0deg); opacity: 0; }
  10%  { opacity: 1; }
  100% { transform: translate(-24px, 130px) rotate(260deg); opacity: 0; }
}

/* Hide on narrow screens */
@media (max-width: 1100px) {
  .side-tree { display: none; }
}
    </style>
